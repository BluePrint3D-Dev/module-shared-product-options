<?php
/**
 * @var \BluePrint3D\SharedProductOptions\Block\Product\View\SharedOptions $block
 * @var \BluePrint3D\SharedProductOptions\ViewModel\SharedOptions $viewModel
 * @var \Magento\Framework\Escaper $escaper
 */

// Grab our custom options data engine injected via Layout arguments
$viewModel = $block->getData('shared_options_helper');

// Custom product entity/attribute group ID loading hook
$assignedGroupId = 1;

$options = $viewModel ? $viewModel->getOptionsByGroupId($assignedGroupId) : [];
?>

<?php if (!empty($options)): ?>
    <div class="blueprint3d-shared-options-container options-list"
         style="margin: 20px 0; padding: 15px 0; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;">
        <?php foreach ($options as $option): ?>
            <?php
            $htmlId = 'shared-option-' . (int)$option['id'];
            $inputName = 'blueprint3d_options[' . (int)$option['id'] . ']';
            $isRequired = (bool)$option['is_required'];
            $requiredValidationAttribute = $isRequired ? 'data-validate="{required:true}"' : '';
            $fieldClass = 'field option field-shared-option-' . $escaper->escapeHtmlAttr((string)$option['id']);
            if ($isRequired) {
                $fieldClass .= ' required';
            }
            ?>

            <div class="<?= /* @noEscape */ $fieldClass ?>" style="margin-bottom: 15px;">
                <label class="label"
                       for="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
                       style="font-weight: 600; display: block; margin-bottom: 5px;">
                    <span><?= $escaper->escapeHtml($option['title']) ?></span>
                    <?php if ($option['price'] > 0): ?>
                        <span class="price-notice" style="font-weight: normal; font-size: 0.9em; color: #666;">
                            (+<?= $escaper->escapeHtml(number_format((float)$option['price'], 2)) ?>)
                        </span>
                    <?php endif; ?>
                </label>

                <div class="control">
                    <?php if ($option['type'] === 'field'): ?>
                        <input type="text"
                               id="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
                               name="<?= $escaper->escapeHtmlAttr($inputName) ?>"
                               class="input-text"
                                <?= /* @noEscape */ $requiredValidationAttribute ?> />

                    <?php elseif ($option['type'] === 'area'): ?>
                        <textarea id="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
                                  name="<?= $escaper->escapeHtmlAttr($inputName) ?>"
                                  class="textarea"
                                  rows="3"
                                  <?= /* @noEscape */ $requiredValidationAttribute ?>></textarea>

                    <?php elseif ($option['type'] === 'drop_down'): ?>
                        <select id="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
                                name="<?= $escaper->escapeHtmlAttr($inputName) ?>"
                                class="select"
                                <?= /* @noEscape */ $requiredValidationAttribute ?>>
                            <option value=""><?= $escaper->escapeHtml(__('-- Please Select --')) ?></option>
                            <?php foreach ($option['values'] as $val): ?>
                                <option value="<?= $escaper->escapeHtmlAttr((string)$val['id']) ?>">
                                    <?= $escaper->escapeHtml($val['title']) ?>
                                    <?php if ($val['price'] > 0): ?>
                                        (+<?= $escaper->escapeHtml(number_format((float)$val['price'], 2)) ?>)
                                    <?php endif; ?>
                                </option>
                            <?php endforeach; ?>
                        </select>

                    <?php elseif ($option['type'] === 'multiple'): ?>
                        <select id="<?= $escaper->escapeHtmlAttr($htmlId) ?>"
                                name="<?= $escaper->escapeHtmlAttr($inputName) ?>[]"
                                class="multiselect"
                                multiple="multiple"
                                size="5"
                                <?= /* @noEscape */ $requiredValidationAttribute ?>>
                            <?php foreach ($option['values'] as $val): ?>
                                <option value="<?= $escaper->escapeHtmlAttr((string)$val['id']) ?>">
                                    <?= $escaper->escapeHtml($val['title']) ?>
                                    <?php if ($val['price'] > 0): ?>
                                        (+<?= $escaper->escapeHtml(number_format((float)$val['price'], 2)) ?>)
                                    <?php endif; ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                    <?php endif; ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

