<?php
/**
 * @var \Magento\Catalog\Block\Product\View\Options\Type\Text $block
 * @var \Magento\Framework\Escaper $escaper
 */

use Magento\Catalog\Api\Data\ProductCustomOptionInterface;

$_option = $block->getOption();
$_class = ($_option->getIsRequire()) ? ' required' : '';
$placeholder = $_option->getData('placeholder');
?>
<div class="field<?= /* @noEscape */ $_class ?>">
    <label class="label" for="options_<?= $escaper->escapeHtmlAttr($_option->getId()) ?>_text">
        <span><?= $escaper->escapeHtml($_option->getTitle()) ?></span>
        <?= /* @noEscape */ $block->getFormattedPrice() ?>
    </label>

    <div class="control">
        <?php if ($_option->getType() == ProductCustomOptionInterface::OPTION_TYPE_FIELD): ?>
            <input type="text"
                   id="options_<?= $escaper->escapeHtmlAttr($_option->getId()) ?>_text"
                   class="input-text<?= $_option->getIsRequire() ? ' required-entry' : '' ?> product-custom-option"
                    <?php if ($_option->getMaxCharacters()): ?>
                        maxlength="<?= (int)$_option->getMaxCharacters() ?>"
                    <?php endif; ?>
                   name="options[<?= $escaper->escapeHtmlAttr($_option->getId()) ?>]"
                   data-selector="options[<?= $escaper->escapeHtmlAttr($_option->getId()) ?>]"
                   value="<?= $escaper->escapeHtmlAttr($block->getDefaultValue()) ?>"
                    <?php if ($placeholder): ?>
                        placeholder="<?= $escaper->escapeHtmlAttr($placeholder) ?>"
                    <?php endif; ?> />
        <?php elseif ($_option->getType() == ProductCustomOptionInterface::OPTION_TYPE_AREA): ?>
            <textarea id="options_<?= $escaper->escapeHtmlAttr($_option->getId()) ?>_text"
                      class="product-custom-option<?= $_option->getIsRequire() ? ' required-entry' : '' ?>"
                      <?php if ($_option->getMaxCharacters()): ?>
                          maxlength="<?= (int)$_option->getMaxCharacters() ?>"
                      <?php endif; ?>
                      name="options[<?= $escaper->escapeHtmlAttr($_option->getId()) ?>]"
                      data-selector="options[<?= $escaper->escapeHtmlAttr($_option->getId()) ?>]"
                      rows="5"
                      cols="25"
                      <?php if ($placeholder): ?>
                          placeholder="<?= $escaper->escapeHtmlAttr($placeholder) ?>"
                      <?php endif; ?>><?= $escaper->escapeHtml($block->getDefaultValue()) ?></textarea>
        <?php endif; ?>
    </div>
</div>