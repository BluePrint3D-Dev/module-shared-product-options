// Re-emits the same gallery config Magento_Catalog's own gallery.phtml builds, via a
// plain script tag (not text/x-magento-init) so it survives untouched even when the
// native mage-init selector match fails to find the gallery placeholder in time. See
// gallery-init-fallback.js, which only acts if the native widget never initialized.
$galleryBlock = $block->getLayout()->getBlock('product.info.media.image');
if (!$galleryBlock) {
    return;
}
?>
<script type="text/javascript">
    window.b3dGalleryFallbackConfig = {
        "mixins": ["magnifier/magnify"],
        "magnifierOpts": <?= /* @noEscape */ $galleryBlock->getMagnifier() ?>,
        "data": <?= /* @noEscape */ $galleryBlock->getGalleryImagesJson() ?>,
        "options": <?= /* @noEscape */ $galleryBlock->getGalleryOptions()->getOptionsJson() ?>,
        "fullscreen": <?= /* @noEscape */ $galleryBlock->getGalleryOptions()->getFSOptionsJson() ?>,
        "breakpoints": <?= /* @noEscape */ $galleryBlock->getBreakpoints() ?>
    };
</script>
